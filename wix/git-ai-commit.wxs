<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v6 per-user installer for git-ai-commit.

  Build (run on the Windows x64 runner only):
    wix build wix/git-ai-commit.wxs wix/Shortcuts.wxs wix/ShortcutOptionsDlg.wxs -arch x64 -d SourceDir=msi-stage -d Version=1.2.3 -ext WixToolset.UI.wixext -o git-ai-commit-windows-amd64.msi

  Preprocessor variables:
    SourceDir - directory containing git-ai-commit.exe to install.
    Version   - strict numeric MAJOR.MINOR.PATCH derived from the release tag.

  MSI is x64-only (x86_64-pc-windows-msvc); windows-arm64 ships as raw
  .exe only. Install scope is per-user under
  LocalAppDataFolder/git-ai-commit with a per-user PATH entry.

  Shortcut options live in wix/Shortcuts.wxs (independent Start Menu /
  Desktop properties and conditional components) and
  wix/ShortcutOptionsDlg.wxs (ShortcutOptionsDlg plus the renamed
  WixUI_GitAiCommit sequence copied from WixUI_InstallDir v6.0.2).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Id="tools.git_ai_commit.git_ai_commit" Name="git-ai-commit" Language="1033" Version="$(var.Version)" Manufacturer="git-ai-commit" UpgradeCode="B5695F3F-30C1-4AE2-9CA7-74CC4A95E84E" Scope="perUser" Compressed="yes">
    <MajorUpgrade AllowDowngrades="no" DowngradeErrorMessage="A newer version of git-ai-commit is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="git-ai-commit" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
    <ui:WixUI Id="WixUI_GitAiCommit" InstallDirectory="INSTALLFOLDER" />
  </Package>
  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="git-ai-commit" />
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="GitAiCommitExeComponent" Guid="ACFDB7A5-653A-4DD2-812A-116730C41051">
        <File Id="GitAiCommitExeFile" Source="$(var.SourceDir)\git-ai-commit.exe" KeyPath="yes" />
        <Environment Id="GitAiCommitUserPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
